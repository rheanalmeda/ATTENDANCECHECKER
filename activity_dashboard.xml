<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="64dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_plmun_logo"
                android:contentDescription="@string/plmun" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plmun"
                android:textColor="#006B2E"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/attendance_checker"
            android:textColor="#006B2E"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#087A32"
            android:layout_marginBottom="22dp" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_student"
            android:textColor="#075B29"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/classText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bsit_3d"
            android:textColor="#356B46"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginBottom="38dp" />

        <Button
            android:id="@+id/qrButton"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:text="@string/my_qr_code"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/attendanceHistoryButton"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:text="@string/my_attendance"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/subjectsButton"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:text="@string/my_subjects"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/profileButton"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:text="@string/my_profile"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:text="@string/logout"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp" />

    </LinearLayout>

</ScrollView>
