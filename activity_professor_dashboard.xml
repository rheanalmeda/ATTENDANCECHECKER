<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/dashboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="64dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_plmun_logo"
                android:contentDescription="@string/plmun1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plmun1"
                android:textColor="#006B2E"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/professor_dashboard"
            android:textColor="#006B2E"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#087A32"
            android:layout_marginBottom="22dp" />

        <TextView
            android:id="@+id/professorWelcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_professor"
            android:textColor="#075B29"
            android:textSize="23sp"
            android:gravity="center"
            android:layout_marginBottom="54dp" />

        <Button
            android:id="@+id/selectClassSubjectButton"
            android:layout_width="320dp"
            android:layout_height="82dp"
            android:text="@string/select_class_and_subject"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/attendanceReportsButton"
            android:layout_width="320dp"
            android:layout_height="82dp"
            android:text="@string/attendance_reports"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/professorLogoutButton"
            android:layout_width="320dp"
            android:layout_height="82dp"
            android:text="@string/logout1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/green_rounded_button"
            android:backgroundTint="@color/bamboo_green"
            android:stateListAnimator="@null"
            android:elevation="3dp" />

    </LinearLayout>

</ScrollView>
